        "current": { "type": "number" },
        "color": { "type": "string" }
      },
      "required": ["userId", "name", "target"]
    },
    "fixedObligations": {
      "title": "Fixed Obligations",
      "description": "Recurring fixed commitments",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "merchant": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "dayOfMonth": { "type": "number" }
